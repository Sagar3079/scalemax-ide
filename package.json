{
  "name": "scalemax-ide",
  "version": "1.0.0-beta.5",
  "description": "ScaleMax IDE — your AI-powered development workspace",
  "main": "main.js",
  "author": "ScaleMax",
  "license": "MIT",
  "scripts": {
    "prestart": "node build/electron-runtime.cjs --check",
    "repair:electron": "node build/electron-runtime.cjs --repair",
    "check:electron": "node build/electron-runtime.cjs --check",
    "start": "node build/dev-app.cjs --run",
    "icons": "electron build/render-icons.cjs",
    "test": "node --test test/*.test.cjs test/*.test.mjs",
    "build": "electron-builder --mac -c.buildVersion=$(git rev-list --count HEAD 2>/dev/null || echo 0)",
    "build:dir": "electron-builder --mac --dir -c.buildVersion=$(git rev-list --count HEAD 2>/dev/null || echo 0)"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.scalemax.ide",
    "productName": "ScaleMax IDE",
    "afterPack": "build/after-pack.cjs",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icons/icon.icns",
      "identity": null,
      "artifactName": "ScaleMax-IDE-${version}-${arch}-mac.${ext}",
      "extendInfo": {
        "NSDesktopFolderUsageDescription": "ScaleMax IDE opens the project folders you choose on your Desktop.",
        "NSDocumentsFolderUsageDescription": "ScaleMax IDE opens the project folders you choose in Documents.",
        "NSDownloadsFolderUsageDescription": "ScaleMax IDE opens the project folders you choose in Downloads."
      }
    },
    "dmg": {
      "artifactName": "ScaleMax-IDE-${version}-${arch}.${ext}"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ]
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
